# ===== ECM AI TEAM — environment =====
# Reuses the live ECM Neon Postgres + Redis. Copy to .env and fill.

# --- Data (shared with ECM) ---
DATABASE_URL=postgres://USER:PASS@HOST/db?sslmode=require
REDIS_URL=redis://127.0.0.1:6379

# --- LLM brain (NVIDIA NIM — OpenAI-compatible) ---
# Get a key at build.nvidia.com (nvapi-...). Models are served free-tier.
LLM_PROVIDER=openai
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-xxxxxxxx
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_MODEL_FAST=meta/llama-3.1-8b-instruct

# --- Gateway ---
PORT=4100
DASHBOARD_PORT=4101
JWT_SECRET=change-me-in-prod
DEFAULT_BRAND_ID=fixmyleads

# --- Provider mode: 'mock' (free, default) or 'live' (real creds below) ---
PROVIDER_MODE=mock

# --- 24/7 Autopilot ---
AUTOPILOT_INTERVAL_MS=60000
AUTOPILOT_BATCH=5
AUTOPILOT_SHEET_URL=
AUTOPILOT_SHEET_EVERY_CYCLES=30

# --- SDR / outreach (only needed when PROVIDER_MODE=live) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
LINKEDIN_COOKIE=

# --- Voice (Python adapter) ---
VOICE_ADAPTER_URL=http://127.0.0.1:4108
TELEPHONY_API_URL=
TELEPHONY_API_TOKEN=

# --- Lead sources ---
GOOGLE_MAPS_SCRAPER=mock
SERP_API_URL=

# --- Control panel ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Booking (Cal.com or any scheduling URL) ---
BOOKING_LINK=

# --- Integrations (optional) ---
NOTION_TOKEN=
GOOGLE_SHEETS_WEBHOOK=

# --- FML Health ---
# WhatsApp (Baileys self-hosted)
WHATSAPP_SESSION_DIR=./session
# Google Calendar (for appointment sync)
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=
# SMS provider (MSG91 / Twilio)
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=FMLHLT
# Review platforms
GOOGLE_PLACES_ID=
# Telephony (for AI calling)
TELEPHONY_PROVIDER=mock
