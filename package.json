{
  "name": "ecm-ai-team",
  "version": "1.0.0",
  "description": "ECM AI Team — Autonomous Revenue System (multi-agent, free-first)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node gateway/server.cjs",
    "gateway": "node gateway/server.cjs",
    "workers": "node workers/index.cjs",
    "dashboard": "node dashboard/server.cjs",
    "control": "node control/bot.cjs",
    "autopilot": "node core/autopilot.cjs",
    "migrate": "node db/migrate.cjs",
    "seed": "node db/seed.cjs",
    "seed:demo": "node db/seed.cjs --demo",
    "test": "node --test tests/",
    "test:watch": "node --test --watch tests/",
    "test:smoke": "node scripts/smoke.cjs",
    "test:check": "node scripts/check.cjs",
    "lint": "node --check gateway/server.cjs && node --check core/config.cjs",
    "deploy": "bash scripts/deploy.sh",
    "set-api-key": "node scripts/set-api-key.cjs",
    "health": "curl -s http://localhost:4100/health",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "clean": "rm -rf node_modules"
  },
  "dependencies": {
    "@wppconnect-team/wppconnect": "^1.28.0",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.7.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.11",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.5"
  },
  "engines": {
    "node": ">=18"
  }
}
